{
  "name": "gatsby-starter-hello-world",
  "private": true,
  "description": "My secondary portfolio build on gatsbyJs",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "develop": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "format": "prettier --write \"**/*.{js,jsx,json,md,mdx}\"",
    "test": "echo \"Write tests! -> https://www.gatsbyjs.com/docs/how-to/testing/\" && exit 1"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "gatsby": "^5.15.0",
    "gatsby-plugin-google-fonts": "^1.0.1",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-react-helmet": "^6.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-source-contentful": "^8.16.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "up": "^1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/parser": "4.0.0",
      "@typescript-eslint/eslint-plugin": "4.0.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "sharp": "0.34.5"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "react"
      ],
      "allowedVersions": {
        "eslint": "9",
        "sharp": "0.34"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "es5-ext",
      "gatsby",
      "gatsby-cli",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
